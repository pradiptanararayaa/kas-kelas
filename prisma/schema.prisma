generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  KETUA
  SISWA
}

enum IncomeType {
  STUDENT_PAYMENT
  OTHER
}

model Setting {
  id             Int      @id @default(1)
  openingBalance Int      @default(0)
  dailyFee       Int      @default(1000)
  startDate      DateTime
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         Role
  active       Boolean  @default(true)
  studentId    String?  @unique
  student      Student? @relation(fields: [studentId], references: [id])
  createdAt    DateTime @default(now())
}

model Student {
  id            String       @id @default(cuid())
  nis           String       @unique
  name          String
  active        Boolean      @default(true)
  creditBalance Int          @default(0)
  startDate     DateTime
  endDate       DateTime?
  user          User?
  allocations   Allocation[]
  incomes       Income[]
  createdAt     DateTime     @default(now())
  @@index([name])
}

model Holiday {
  date DateTime @id
  name String
}

model Allocation {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id])
  dueDate   DateTime
  amount    Int
  activeKey String?   @unique
  paidAt    DateTime  @default(now())
  voidedAt  DateTime?
  @@index([studentId, dueDate])
}

model Income {
  id          String     @id @default(cuid())
  type        IncomeType
  amount      Int
  date        DateTime
  description String?
  studentId   String?
  student     Student?   @relation(fields: [studentId], references: [id])
  createdById String
  createdAt   DateTime   @default(now())
  voidedAt    DateTime?
  voidReason  String?
  @@index([date])
}

model Expense {
  id          String    @id @default(cuid())
  amount      Int
  date        DateTime
  category    String
  description String
  proofUrl    String?
  createdById String
  createdAt   DateTime  @default(now())
  voidedAt    DateTime?
  voidReason  String?
  @@index([date])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}
